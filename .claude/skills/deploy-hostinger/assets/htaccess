# Cache policy for the PHONEX ULTRA static site on Hostinger (Apache)
# Frames, fonts and vendor libraries are content-stable → cache hard.
# Entry files (HTML/CSS/JS) change on every edit → always revalidate.

<IfModule mod_headers.c>
  # Scrub frames, stills, fonts, vendored JS: immutable for a year
  <FilesMatch "\.(jpg|jpeg|png|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(gsap|ScrollTrigger|lenis)\.min\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Entry files: revalidate on every load so deploys show up immediately
  <FilesMatch "^(index\.html|styles\.css|main\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Serve pre-compressed responses where Hostinger has mod_deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# The film frames are already JPEG-compressed; never let PHP handlers touch a static dir
Options -Indexes
